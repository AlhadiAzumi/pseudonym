APP_ENV=development
APP_NAME=Pseudonym
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://pseudonym.site

# Database Configuration
DB_HOST=your-supabase-pooler-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASS=your-database-password
DB_SSLMODE=require

# Google OAuth Credentials (dari Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://pseudonym.site/auth/google-callback

# Akun Google yang boleh membuka dashboard administrasi
ADMIN_EMAIL=

# Anti-spam (gunakan nilai acak rahasia untuk APP_FINGERPRINT_SALT)
APP_FINGERPRINT_SALT=replace-with-a-long-random-secret
MAX_MESSAGES_PER_DAY=20
MAX_MESSAGES_PER_HOUR=10
MAX_MESSAGES_TARGET_PER_HOUR=60