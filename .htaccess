RewriteEngine On

# Jangan ubah URL jika yang diakses adalah file/folder asli (seperti assets, gambar, atau dashboard.php)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Ubah namadomain.com/username menjadi namadomain.com/u.php?u=username di belakang layar
RewriteRule ^([a-zA-Z0-9_.-]+)/?$ u.php?u=$1 [L,QSA]