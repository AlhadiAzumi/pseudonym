<IfModule mod_rewrite.c>
    RewriteEngine On

    # Lindungi folder sistem agar tidak bisa diakses langsung dari browser
    RewriteRule ^(app|bootstrap|config|database|resources|storage|vendor)/ - [F,L]

    # Lewati file dan direktori yang memang ada
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Arahkan seluruh request ke index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>